{
  "description": "Two tool calls with null content, and their tool messages.",
  "format": "openai-chat",
  "covers": [
    "parallel-tool-calls",
    "null-content"
  ],
  "messages": [
    {
      "role": "user",
      "content": "Weather in Paris and Rome?"
    },
    {
      "role": "assistant",
      "content": null,
      "tool_calls": [
        {
          "id": "call_1",
          "type": "function",
          "function": {
            "name": "get_weather",
            "arguments": "{\"city\":\"Paris\"}"
          }
        },
        {
          "id": "call_2",
          "type": "function",
          "function": {
            "name": "get_weather",
            "arguments": "{\"city\":\"Rome\"}"
          }
        }
      ]
    },
    {
      "role": "tool",
      "tool_call_id": "call_1",
      "content": "18°C"
    },
    {
      "role": "tool",
      "tool_call_id": "call_2",
      "content": "21°C"
    }
  ]
}
