{
  "description": "A function output made of text and an image.",
  "format": "openai-responses",
  "covers": [
    "tool-result-blocks",
    "images"
  ],
  "input": [
    {
      "type": "function_call",
      "call_id": "call_D",
      "name": "screenshot",
      "arguments": "{}"
    },
    {
      "type": "function_call_output",
      "call_id": "call_D",
      "output": [
        {
          "type": "input_text",
          "text": "Screenshot taken."
        },
        {
          "type": "input_image",
          "image_url": "data:image/png;base64,iVBORw0KGgo="
        }
      ]
    }
  ]
}
